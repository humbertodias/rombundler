# PlayStation Vita homebrew toolchain.
#   docker build -t rombundler-vita -f docker/Dockerfile.vita docker/
#
# Toolchain only: does not clone this repo or bake ROMBundler into the image.
# Compiler, vitasdk, CMake, vita-elf-create / vita-make-fself / vita-pack-vpk
# come from vitasdk/vitasdk. Host tools are added for Ninja/zip.

FROM vitasdk/vitasdk:latest

ENV PLATFORM=vita \
    VITASDK=/usr/local/vitasdk \
    PATH="/usr/local/vitasdk/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        gcc \
        g++ \
        git \
        ninja-build \
        zip \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*' \
    && if [ -n "${VITASDK}" ] && [ -d "${VITASDK}" ]; then chmod -R a+rX "${VITASDK}"; fi

# vitaShaRK first so headers match current vitaGL. HAVE_SCE_SHACCCG enables
# runtime GLSL via Sony libshacccg.suprx (required on real hardware).
# HAVE_VITA3K_SUPPORT keeps the emulator-friendly GXM path when possible.
RUN set -eux; \
    git clone --depth 1 https://github.com/Rinnegatamante/vitaShaRK.git /tmp/vitaShaRK; \
    make -C /tmp/vitaShaRK -j"$(nproc)"; \
    make -C /tmp/vitaShaRK install; \
    rm -rf /tmp/vitaShaRK; \
    git clone --depth 1 https://github.com/Rinnegatamante/vitaGL.git /tmp/vitaGL; \
    make -C /tmp/vitaGL -j"$(nproc)" HAVE_SCE_SHACCCG=1 HAVE_VITA3K_SUPPORT=1 NO_SPLASHSCREEN=1; \
    make -C /tmp/vitaGL install; \
    rm -rf /tmp/vitaGL

WORKDIR /src
CMD ["bash"]
