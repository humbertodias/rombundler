# Nintendo Switch homebrew toolchain (linux/amd64: devkitA64 host tools are x86_64).
#   docker build --platform linux/amd64 -t rombundler-switch \
#     -f docker/Dockerfile.switch docker/
#
# Toolchain only: does not clone this repo or bake ROMBundler into the image.

FROM devkitpro/devkita64:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=switch \
    DEVKITPRO=/opt/devkitpro \
    DEVKITARM=/opt/devkitpro/devkitARM \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo

# cores.sh runs `bash -lc`, which rebuilds PATH from /etc/profile.
# profile.d/rust.sh puts cargo back on that PATH.
ENV PATH="${CARGO_HOME}/bin:${DEVKITPRO}/tools/bin:${DEVKITPRO}/devkitA64/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        ninja-build \
        pkg-config \
        python3 \
        zip \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

# Shared toolchain: cores.sh runs the container as the host uid, not root.
# aarch64-unknown-linux-gnu is the prebuilt std that emits EM_AARCH64 objects.
# devkitA64's ld rejects the host x86_64 staticlib (EM: 62).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path \
    && rustup target add aarch64-unknown-linux-gnu \
    && chmod -R a+rwX "${RUSTUP_HOME}" "${CARGO_HOME}" \
    && printf 'export RUSTUP_HOME=%s\nexport CARGO_HOME=%s\nexport PATH="%s/bin:${PATH}"\n' \
        "${RUSTUP_HOME}" "${CARGO_HOME}" "${CARGO_HOME}" > /etc/profile.d/rust.sh \
    && rustup target list --installed | grep -qx aarch64-unknown-linux-gnu

# switch-mesa is not always in the base image. pkg.devkitpro.org often returns 403;
# dkp-pacman is the real client (there is no `pacman` on PATH). Retry instead of
# falling through. Skip the fetch when EGL is already installed.
RUN set -eux; \
    if [ -f "${DEVKITPRO}/portlibs/switch/lib/libEGL.a" ]; then \
      echo "switch-mesa already present"; \
    else \
      PACMAN="$(command -v dkp-pacman || true)"; \
      if [ -z "${PACMAN}" ] && [ -x "${DEVKITPRO}/pacman/bin/pacman" ]; then \
        PACMAN="${DEVKITPRO}/pacman/bin/pacman"; \
      fi; \
      if [ -z "${PACMAN}" ]; then \
        echo "dkp-pacman not found and switch-mesa is missing" >&2; \
        exit 1; \
      fi; \
      i=0; \
      until "${PACMAN}" -Sy --noconfirm \
        && "${PACMAN}" -S --noconfirm --needed switch-mesa switch-libdrm_nouveau; do \
        i=$((i + 1)); \
        if [ "${i}" -ge 6 ]; then \
          echo "dkp-pacman failed after retries (pkg.devkitpro.org 403?)" >&2; \
          exit 1; \
        fi; \
        sleep $((i * 12)); \
      done; \
      "${PACMAN}" -Scc --noconfirm || true; \
    fi; \
    chmod -R a+rX "${DEVKITPRO}"

WORKDIR /src
CMD ["bash"]
