# Nintendo Switch homebrew toolchain (linux/amd64: devkitA64 host tools are x86_64).
#   docker build --platform linux/amd64 -t rombundler-switch \
#     -f docker/Dockerfile.switch docker/
#
# Toolchain only: does not clone this repo or bake ROMBundler into the image.

FROM devkitpro/devkita64:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=switch \
    DEVKITPRO=/opt/devkitpro \
    DEVKITARM=/opt/devkitpro/devkitARM

ENV PATH="${DEVKITPRO}/tools/bin:${DEVKITPRO}/devkitA64/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        ninja-build \
        pkg-config \
        python3 \
        zip \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

# switch-mesa is not always in the base image. pkg.devkitpro.org often returns 403;
# dkp-pacman is the real client (there is no `pacman` on PATH). Retry instead of
# falling through. Skip the fetch when EGL is already installed.
RUN set -eux; \
    if [ -f "${DEVKITPRO}/portlibs/switch/lib/libEGL.a" ]; then \
      echo "switch-mesa already present"; \
    else \
      PACMAN="$(command -v dkp-pacman || true)"; \
      if [ -z "${PACMAN}" ] && [ -x "${DEVKITPRO}/pacman/bin/pacman" ]; then \
        PACMAN="${DEVKITPRO}/pacman/bin/pacman"; \
      fi; \
      if [ -z "${PACMAN}" ]; then \
        echo "dkp-pacman not found and switch-mesa is missing" >&2; \
        exit 1; \
      fi; \
      i=0; \
      until "${PACMAN}" -Sy --noconfirm \
        && "${PACMAN}" -S --noconfirm --needed switch-mesa switch-libdrm_nouveau; do \
        i=$((i + 1)); \
        if [ "${i}" -ge 6 ]; then \
          echo "dkp-pacman failed after retries (pkg.devkitpro.org 403?)" >&2; \
          exit 1; \
        fi; \
        sleep $((i * 12)); \
      done; \
      "${PACMAN}" -Scc --noconfirm || true; \
    fi; \
    chmod -R a+rX "${DEVKITPRO}"

WORKDIR /src
CMD ["bash"]
