BEETLE_NEOPOP=https://github.com/libretro/beetle-ngp-libretro.git,master,make -f Makefile.libretro
BEETLE_PCFX=https://github.com/libretro/beetle-pcfx-libretro.git,master,make -f Makefile.libretro
BEETLE_PCE=https://github.com/libretro/beetle-pce-fast-libretro.git,master,make -f Makefile.libretro
BEETLE_PCE_FAST=https://github.com/libretro/beetle-pce-fast-libretro.git,master,make -f Makefile.libretro
