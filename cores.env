# Libretro core registry: NAME=git-url,branch,command
# Used by cores.sh / build.sh (--fetch-core name). Lookup is case-insensitive;
# hyphens match underscores (genesis-plus-gx → GENESIS_PLUS_GX). Prefer lowercase
# on the command line; keys here stay UPPER_SNAKE for the registry.
#
# branch: git branch passed to `git clone --branch`.
# command: build line run at the clone root. For make commands, cores.sh appends
#   platform=<libnx|vita|emscripten>, -j$(nproc), and $MAKE_FLAGS. On wasm, make
#   is prefixed with emmake (and fpic=-fPIC); cmake is prefixed with emcmake.
#
# Add a line here to expose a new core. CI matrices use the NAME, not the URL.

2048=https://github.com/libretro/libretro-2048.git,master,make -f Makefile.libretro
3DENGINE=https://github.com/libretro/libretro-3dengine.git,master,make -f Makefile.libretro
81=https://github.com/libretro/81-libretro.git,master,make -f Makefile.libretro
A5200=https://github.com/libretro/a5200.git,master,make -f Makefile
ANARCH=https://github.com/libretro/anarch.git,master,make -f Makefile.libretro
ARDENS=https://github.com/libretro/ardens.git,master,make -f Makefile.libretro
ARMAJET=https://github.com/libretro/armajet.git,master,make -f Makefile.libretro
ARDUOUS=https://github.com/libretro/arduous.git,main,cmake -S . -B build -DCMAKE_POSITION_INDEPENDENT_CODE=TRUE -DCMAKE_BUILD_TYPE=Release && cmake --build build
ATARI800=https://github.com/libretro/libretro-atari800.git,master,make -f Makefile
ATARI2600=https://github.com/libretro/stella2014-libretro.git,master,make -f Makefile.libretro
ATARI7800=https://github.com/libretro/prosystem-libretro.git,master,make -f Makefile.libretro
BEETLE_BSNES=https://github.com/libretro/bsnes-libretro.git,master,make -C bsnes -f GNUmakefile local=portable binary=library target=libretro
BEETLE_CYGNE=https://github.com/libretro/beetle-wswan-libretro.git,master,make -f Makefile.libretro
BEETLE_GBA=https://github.com/libretro/beetle-gba-libretro.git,master,make -f Makefile.libretro
